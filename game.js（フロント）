let dlg = null; const pc = $('#portrait').getContext('2d');
function drawPortrait(kind) {
  pc.clearRect(0, 0, 120, 120);
  if (!kind) { pc.fillStyle = '#9fb0ff'; pc.font = '60px sans-serif'; pc.textAlign = 'center'; pc.fillText('📜', 60, 80); return; }
  pc.save();
  if (kind === 'king') drawKing(pc, 60, 118, 118, 0);
  else if (kind === 'hero') drawHero(pc, 60, 118, 118, 'down', 0, false);
  else if (kind === 'princess') drawPrincess(pc, 60, 116, 100, 0);
  else if (kind === 'demon') { drawMonster(pc, 'demon', 60, 150, 62, 0); }
  else drawVillager(pc, 60, 118, 118, 0, kind === 'v0' ? 0 : kind === 'v1' ? 1 : 2);
  pc.restore();
}
function say(lines, cb) {
  dlg = { lines, i: 0, pos: 0, cb, snd: 0 }; $('#dialog').classList.add('show'); setDlgLine(); showPromptHide();
}
function showPromptHide() { $('#prompt').style.display = 'none'; }
function setDlgLine() { const l = dlg.lines[dlg.i]; dlg.pos = 0; $('#dname').textContent = l.who || ''; drawPortrait(l.kind); $('#dline').textContent = ''; $('#darrow').style.visibility = 'hidden'; }
function updateDlg(dt) {
  if (!dlg) return; const l = dlg.lines[dlg.i], text = l.text;
  if (dlg.pos < text.length) { dlg.pos = Math.min(text.length, dlg.pos + dt * 42); $('#dline').textContent = text.slice(0, Math.floor(dlg.pos)); if (Math.floor(dlg.pos) % 2 === 0 && Math.floor(dlg.pos) !== dlg.snd) { dlg.snd = Math.floor(dlg.pos); SFX.talk(); } }
  else $('#darrow').style.visibility = 'visible';
}
function advanceDlg() {
  const l = dlg.lines[dlg.i]; if (dlg.pos < l.text.length) { dlg.pos = l.text.length; return; }
  dlg.i++; if (dlg.i >= dlg.lines.length) { const cb = dlg.cb; dlg = null; $('#dialog').classList.remove('show'); cb && cb(); } else { SFX.sel(); setDlgLine(); }
}
$('#dialog').addEventListener('pointerdown', () => dlg && advanceDlg());


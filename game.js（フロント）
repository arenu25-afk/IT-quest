const SOLID = '#~MC';
function tileAt(tx, ty) { return (ty < 0 || ty >= MR || tx < 0 || tx >= MC) ? '#' : MAP[ty][tx]; }
function blocked(px, py) {
  const ch = tileAt(Math.floor(px / TS), Math.floor(py / TS)); if (SOLID.includes(ch)) return true;
  for (const n of NPCS) { if (Math.abs(px - (n.x * TS + 24)) < 15 && py > n.y * TS + 22 && py < n.y * TS + 46) return true; }
  return false;
}
function canStand(x, y) { return !(blocked(x - 11, y) || blocked(x + 11, y) || blocked(x - 11, y - 10) || blocked(x + 11, y - 10)); }
let stepT = 0;
function updateMap(dt) {
  if (dlg || modalOpen || resultOpen || screen !== 'map') { P.moving = false; return; }
  let dx = 0, dy = 0;
  if (keys.left || keys.a) dx -= 1; if (keys.right || keys.d) dx += 1; if (keys.up || keys.w) dy -= 1; if (keys.down || keys.s) dy += 1;
  P.moving = !!(dx || dy);
  if (P.moving) {
    if (dx && dy) { dx *= .7071; dy *= .7071; }
    const sp = 175 * dt;
    if (Math.abs(dx) >= Math.abs(dy) && dx) P.dir = dx < 0 ? 'left' : 'right'; else if (dy) P.dir = dy < 0 ? 'up' : 'down';
    if (canStand(P.x + dx * sp, P.y)) P.x += dx * sp;
    if (canStand(P.x, P.y + dy * sp)) P.y += dy * sp;
    stepT += dt; if (stepT > .24) { stepT = 0; SFX.step(); }
  }
  // プロンプト
  const tx = Math.floor(P.x / TS), ty = Math.floor((P.y - 4) / TS); const ch = tileAt(tx, ty);
  const pr = $('#prompt'); let txt = '';
  nearAct = null;
  if (GATES[ch] && GATES[ch].x === tx && GATES[ch].y === ty) {
    const g = GATES[ch];
    if (ch === 'X') { txt = allDone() ? '⚔ Z / Enter：魔王城に突入する！' : '🔒 封印されている…（3つの洞窟をクリアせよ）'; nearAct = { t: 'gate', ch }; }
    else { txt = `Z / Enter：${stageId(ch)} ${FIELD_NAME[g.f]}に挑戦！` + (PLAY.stages[ch] ? '（クリア済み）' : ''); nearAct = { t: 'gate', ch }; }
  } else {
    for (const n of NPCS) if (Math.hypot(P.x - (n.x * TS + 24), (P.y - 20) - (n.y * TS + 24)) < 58) { txt = `Z / Enter：${n.name}に話しかける`; nearAct = { t: 'npc', n }; break; }
  }
  pr.style.display = txt ? 'block' : 'none'; if (txt) pr.textContent = txt;
}
let nearAct = null;
function actionMap() {
  if (!nearAct) return;
  if (nearAct.t === 'npc') return talkNpc(nearAct.n);
  const ch = nearAct.ch;
  if (ch === 'X') { if (!allDone()) { SFX.ng(); return say([{ who: null, text: '城門は 固く封印されている……。' }, { who: null, text: '3つの洞窟（ストラテジ・マネジメント・テクノロジ）の サブボスを倒せ！' }]); } return story('prefinal'); }
  openModal(`<h3>${stageId(ch)}　${FIELD_NAME[GATES[ch].f]}</h3><p>ザコ 15体 ＋ サブボス 1体。<br>ザコ戦：HP800（ミス -100）／サブボス戦：HP2000（ミス -1000・3問正解で撃破）</p>`,
    [{ t: '挑戦する！', cb: () => { closeModal(); startBattle({ kind: 'stage', k: ch, field: GATES[ch].f }); } }, { t: 'やめる', cb: closeModal }],
    e => { if (e.key === 'Enter' || e.key === 'z') { closeModal(); startBattle({ kind: 'stage', k: ch, field: GATES[ch].f }); return true; } });
}

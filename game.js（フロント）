const bcv = $('#bcv'), bc = bcv.getContext('2d');
let B = null, resultOpen = false;
function poolFor(field) { return field === 'f' ? ['s', 'm', 't'].flatMap(k => QUESTIONS[k].map(q => ({ f: k, q }))) : QUESTIONS[field].map(q => ({ f: field, q })); }

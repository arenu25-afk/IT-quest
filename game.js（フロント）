    if (d) return say([{ who: '王様', kind: 'king', text: '城門の封印が解けたぞ！ ミライ姫を 頼んだぞ、' + SAVE.name + '！' }]);
    return say([{ who: '王様', kind: 'king', text: SAVE.name + 'よ、洞窟の試練を 乗り越えるのじゃ。' }, { who: '王様', kind: 'king', text: '3つの洞窟を すべてクリアすれば 魔王城への道が 開かれるぞ。' }]);

    c.fillStyle = 'rgba(0,0,0,.08)'; for (let i = 0; i < 3; i++) { const ox = (h >> (i * 4)) % 40 + 4, oy = (h >> (i * 4 + 2)) % 40 + 4; c.fillRect(px + ox, py + oy, 2, 5); c.fillRect(px + ox + 3, py + oy + 2, 2, 4); }
  };
  switch (ch) {
    case '~': { c.fillStyle = th.water; c.fillRect(px, py, TS, TS); c.strokeStyle = 'rgba(255,255,255,.45)'; c.lineWidth = 2; for (let i = 0; i < 2; i++) { const o = Math.sin(T * .05 + x + i * 2) * 4; c.beginPath(); c.moveTo(px + 6 + o, py + 14 + i * 22); c.quadraticCurveTo(px + 16 + o, py + 8 + i * 22, px + 26 + o, py + 14 + i * 22); c.stroke(); } break; }
    case 'b': { c.fillStyle = th.water; c.fillRect(px, py, TS, TS); rect(c, px + 4, py - 2, TS - 8, TS + 4, '#a8742e'); for (let i = 0; i < 6; i++) rect(c, px + 4, py + i * 8 - 1, TS - 8, 2, '#6a4418'); rect(c, px + 4, py - 2, 4, TS + 4, '#7a5220'); rect(c, px + TS - 8, py - 2, 4, TS + 4, '#7a5220'); break; }
    case '=': case '1': case '2': case '3': case 'X': { c.fillStyle = th.path; c.fillRect(px, py, TS, TS); c.fillStyle = 'rgba(0,0,0,.1)'; for (let i = 0; i < 4; i++) c.fillRect(px + (h >> (i * 3)) % 40 + 3, py + (h >> (i * 3 + 1)) % 40 + 3, 5, 3); break; }
    case '#': { grass(); rect(c, px + 20, py + 28, 8, 16, '#6a4020'); ell(c, px + 24, py + 22, 20, 18, th.tree); ell(c, px + 17, py + 17, 11, 10, 'rgba(255,255,255,.14)'); ell(c, px + 32, py + 26, 9, 8, 'rgba(0,0,0,.12)'); break; }
    case 'M': { grass(); poly(c, [[2, 44], [24, 4], [46, 44]].map(p => [px + p[0], py + p[1]]), '#7c7f94'); poly(c, [[24, 4], [46, 44], [28, 44], [26, 22]].map(p => [px + p[0], py + p[1]]), '#5e6178'); poly(c, [[24, 4], [17, 17], [24, 14], [31, 18]].map(p => [px + p[0], py + p[1]]), '#fff'); break; }
    case 'f': { grass(); for (let i = 0; i < 4; i++) { const fx = px + 8 + (h >> (i * 3)) % 32, fy = py + 10 + (h >> (i * 3 + 1)) % 30, sw = Math.sin(T * .05 + i + x) * 1.2; ln(c, fx, fy + 6, fx + sw, fy, '#2e8a3a', 1.5); ell(c, fx + sw, fy, 3.5, 3.5, ['#ff6fa8', '#ffd54a', '#fff', '#8fb8ff'][(h + i) % 4]); ell(c, fx + sw, fy, 1.2, 1.2, '#c46a00'); } break; }
    default: grass();
  }
}
function drawGate(c, g, ch, T, th) {
  const x = g.x * TS, y = g.y * TS, col = { s: '#ff9a3a', m: '#4d8dff', t: '#2fd67a', f: '#c23aff' }[g.f];
  if (ch === 'X') {
    const open = allDone(); c.save(); c.translate(x + 24, y + 46);
    ell(c, 0, 0, 34, 7, 'rgba(0,0,0,.3)');
    rect(c, -32, -44, 64, 44, '#2a1648'); rect(c, -32, -50, 14, 8, '#2a1648'); rect(c, -6, -50, 12, 8, '#2a1648'); rect(c, 18, -50, 14, 8, '#2a1648');
    poly(c, [[-38, -44], [-26, -66], [-14, -44]], '#1a0c30'); poly(c, [[14, -44], [26, -66], [38, -44]], '#1a0c30'); poly(c, [[-14, -44], [0, -72], [14, -44]], '#3a1c68');
    c.beginPath(); c.moveTo(-18, 0); c.lineTo(-18, -26); c.quadraticCurveTo(0, -48, 18, -26); c.lineTo(18, 0); c.closePath(); c.fillStyle = open ? '#08000f' : '#3a1c58'; c.fill();
    if (open) { for (let i = 0; i < 6; i++) { const f = Math.sin(T * .12 + i * 1.7); ell(c, -12 + i * 5, -8 - Math.abs(f) * 14, 3, 5 + Math.abs(f) * 6, 'rgba(255,60,140,.75)'); } ell(c, 0, -22, 4, 4, '#ff3a6a'); }
    else { ln(c, -18, -30, 18, -4, '#aaa', 4); ln(c, 18, -30, -18, -4, '#aaa', 4); rr(c, -7, -22, 14, 12, 3, '#ffd54a'); arc(c, 0, -22, 5, Math.PI, 0, '#ffd54a', 3); }
    ell(c, 0, -62, 5, 5, open ? '#ff3a6a' : '#6a3a8a');
    c.restore(); return;
  }
  c.save(); c.translate(x + 24, y + 46);
  ell(c, 0, 0, 30, 7, 'rgba(0,0,0,.3)');
  c.beginPath(); c.moveTo(-26, 0); c.lineTo(-26, -34); c.quadraticCurveTo(0, -70, 26, -34); c.lineTo(26, 0); c.closePath(); c.fillStyle = '#7a7d92'; c.fill();
  for (let i = 0; i < 5; i++) rect(c, -26 + (i % 2) * 8, -6 - i * 7, 14, 1.5, 'rgba(0,0,0,.25)');
  c.beginPath(); c.moveTo(-15, 0); c.lineTo(-15, -26); c.quadraticCurveTo(0, -48, 15, -26); c.lineTo(15, 0); c.closePath(); c.fillStyle = '#07070f'; c.fill();
  c.beginPath(); c.moveTo(-15, 0); c.lineTo(-15, -26); c.quadraticCurveTo(0, -48, 15, -26); c.lineTo(15, 0); c.closePath(); c.fillStyle = col; c.globalAlpha = .18 + Math.sin(T * .08) * .08; c.fill(); c.globalAlpha = 1;
  rr(c, -15, -66, 30, 17, 4, col); c.fillStyle = '#fff'; c.font = 'bold 13px sans-serif'; c.textAlign = 'center'; c.fillText(PLAY.area + '-' + ch, 0, -53);
  if (PLAY.stages[ch]) { c.fillStyle = '#ffd54a'; c.font = '20px sans-serif'; c.fillText('★', 0, -72); }
  c.restore();
}
function drawCastle(c) {
  const x = 9 * TS, y = 8 * TS; c.save(); c.translate(x, y);
  rect(c, 8, 22, 128, 74, '#c8cadf'); rect(c, 8, 22, 128, 74, '#c8cadf');
  for (let i = 0; i < 8; i++) { rect(c, 10 + i * 16, 14, 10, 12, '#c8cadf'); }
  for (const tx of [-6, 114]) { rect(c, tx, 0, 36, 96, '#b4b7d2'); poly(c, [[tx - 5, 0], [tx + 18, -34], [tx + 41, 0]], '#d6283b'); for (let i = 0; i < 3; i++) rect(c, tx + 12, 14 + i * 22, 12, 14, '#2a3a6a'); }
  poly(c, [[50, 22], [72, -14], [94, 22]], '#2f6bf0'); ln(c, 72, -14, 72, -34, '#555', 2); poly(c, [[72, -34], [90, -28], [72, -22]], '#ffd54a');
  c.beginPath(); c.moveTo(56, 96); c.lineTo(56, 62); c.quadraticCurveTo(72, 40, 88, 62); c.lineTo(88, 96); c.closePath(); c.fillStyle = '#6a3a1a'; c.fill();
  ln(c, 72, 48, 72, 96, '#3a1a0a', 2); ell(c, 80, 78, 2, 2, '#ffd54a');
  for (let i = 0; i < 6; i++) rect(c, 10, 30 + i * 11, 128, 1.5, 'rgba(0,0,0,.1)');
  c.restore();
}
function drawMap(T) {
  const c = mc, th = themeOf(PLAY.area);
  c.fillStyle = th.g1; c.fillRect(0, 0, W, 528);
  for (let y = 0; y < MR; y++) for (let x = 0; x < MC; x++) drawTile(c, MAP[y][x], x, y, T, th);
  drawCastle(c);
  for (const k in GATES) drawGate(c, GATES[k], k, T, th);
  // エンティティ（奥から手前へ）
  const ents = NPCS.map(n => ({ y: n.y * TS + 44, f: () => { const bx = n.x * TS + 24, by = n.y * TS + 44; if (n.kind === 'king') drawKing(c, bx, by, 54, T); else drawVillager(c, bx, by, 50, T, +n.kind[1]); } }));
  ents.push({ y: P.y, f: () => drawHero(c, P.x, P.y, 54, P.dir, T, P.moving) });
  ents.sort((a, b) => a.y - b.y).forEach(e => e.f());
  // 空気感（周辺をうっすら暗く）
  const g = c.createRadialGradient(480, 264, 280, 480, 264, 620); g.addColorStop(0, 'rgba(0,0,0,0)'); g.addColorStop(1, 'rgba(0,0,30,.35)'); c.fillStyle = g; c.fillRect(0, 0, W, 528);
}


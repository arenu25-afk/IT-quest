  B.enemy.alpha = 1; B.enemy.appear = 0; B.enemy.dx = 0; B.enemy.dead = false;
  // 画面
  $('#nextBtn').style.display = 'none'; $('#qres').style.display = 'none'; $('#qmain').style.display = 'block';

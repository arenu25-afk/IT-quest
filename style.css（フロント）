/* ===== ITクエスト style.css ===== */
:root{--gold:#ffd54a;--ink:#0b1030;--line:#eef1ff;--ok:#2fbf6a;--ng:#e5484d}
*{box-sizing:border-box;margin:0;padding:0;-webkit-user-select:none;user-select:none;-webkit-tap-highlight-color:transparent}
html,body{height:100%;background:#04061a;overflow:hidden;color:#fff;
  font-family:'DotGothic16','Hiragino Kaku Gothic ProN','Yu Gothic','Meiryo',sans-serif}
#wrap{position:fixed;inset:0;display:flex;align-items:center;justify-content:center}
#stage{width:960px;height:540px;position:relative;flex:none;overflow:hidden;background:#000;transform-origin:center center}
.screen{position:absolute;inset:0;display:none}
.screen.active{display:block}
canvas{display:block}
button{font-family:inherit;color:inherit;cursor:pointer}

/* ウィンドウ */
.win{background:linear-gradient(#1a2672,#0c1244);border:3px solid var(--line);border-radius:10px;
  box-shadow:0 0 0 3px var(--ink),0 6px 14px rgba(0,0,0,.45)}

/* ===== タイトル ===== */
#tcv{position:absolute;inset:0}
.logo{position:absolute;left:0;right:0;top:34px;text-align:center;text-shadow:0 4px 0 rgba(0,0,0,.5)}
.logo-sub{font-size:20px;letter-spacing:.4em;color:#bfe3ff}
.logo h1{font-size:108px;line-height:1.05;letter-spacing:.06em;color:#fff;
  -webkit-text-stroke:3px #1b2a8a;paint-order:stroke fill;text-shadow:0 6px 0 #1b2a8a,0 12px 24px rgba(0,0,0,.6)}
.logo h1 span{color:var(--gold);-webkit-text-stroke:3px #8a4b00;text-shadow:0 6px 0 #8a4b00,0 12px 24px rgba(0,0,0,.6)}
.logo-tag{font-size:22px;color:#ffe9a8;margin-top:2px}
.menu{position:absolute;left:50%;transform:translateX(-50%);bottom:56px;display:grid;grid-template-columns:1fr 1fr;gap:12px 16px;width:560px}
.mbtn{padding:13px 10px;font-size:24px;text-align:left;padding-left:26px;background:linear-gradient(#1c2a80,#0d1550);
  border:3px solid #fff;border-radius:10px;box-shadow:0 0 0 3px var(--ink),0 5px 0 3px var(--ink);transition:.08s}
.mbtn:hover,.mbtn.focus{border-color:var(--gold);color:var(--gold);transform:translateY(-2px)}
.mbtn:disabled{opacity:.4;cursor:default;transform:none;color:#fff;border-color:#fff}
.foot{position:absolute;bottom:12px;width:100%;text-align:center;font-size:14px;color:#a9b4e6}

/* ===== マップ ===== */
#mcv{position:absolute;left:0;top:6px}
#mhud{position:absolute;inset:0;pointer-events:none}
#mhud button{pointer-events:auto}
.hud-area{position:absolute;left:10px;top:10px;padding:7px 10px;display:flex;align-items:center;gap:10px}
#areaName{font-size:20px;color:var(--gold)}
#areaSub{font-size:13px;color:#bcd}
.mini{background:#0c1244;border:2px solid #fff;border-radius:6px;width:30px;height:30px;font-size:14px}
.mini:hover{border-color:var(--gold)}
.mini:disabled{opacity:.3;cursor:default}
.hud-clear{position:absolute;right:10px;top:10px;padding:8px 14px;font-size:16px;height:50px;display:flex;align-items:center}
.hud-clear b{font-size:26px;color:var(--gold);margin-left:8px}
.hud-stages{position:absolute;left:278px;top:10px;padding:0 14px;font-size:15px;height:50px;display:flex;align-items:center;gap:16px;white-space:nowrap}
.hud-stages .done{color:var(--gold)}
.hud-stages .lock{color:#889}
#prompt{position:absolute;left:50%;bottom:34px;transform:translateX(-50%);padding:8px 18px;font-size:19px;display:none;white-space:nowrap}
.help{position:absolute;left:10px;bottom:6px;font-size:13px;color:#fff;text-shadow:0 1px 3px #000,0 0 6px #000;opacity:.9}
#touch{display:none}
@media (pointer:coarse){
  #touch{display:block}
  .help{display:none}
  .dpad{position:absolute;left:14px;bottom:14px;width:168px;height:168px;display:grid;grid-template-columns:repeat(3,56px);grid-template-rows:repeat(3,56px)}
  .dpad button{background:rgba(255,255,255,.22);border:2px solid rgba(255,255,255,.7);border-radius:12px;font-size:22px;color:#fff}
  .dpad [data-k=up]{grid-area:1/2}.dpad [data-k=left]{grid-area:2/1}.dpad [data-k=right]{grid-area:2/3}.dpad [data-k=down]{grid-area:3/2}
  #abtn{position:absolute;right:18px;bottom:30px;width:84px;height:84px;border-radius:50%;background:rgba(255,213,74,.35);border:3px solid var(--gold);font-size:34px;color:#fff}
}

/* ===== バトル ===== */
#bcv{position:absolute;left:0;top:0}
.bhud-hero{position:absolute;left:12px;top:10px;width:268px;padding:8px 12px}
.bhud-enemy{position:absolute;right:12px;top:10px;width:300px;padding:8px 12px;text-align:right}
.nm{font-size:19px;color:var(--gold)}
.hpline{display:flex;align-items:center;gap:8px;margin-top:4px;font-size:15px}
.hpbar{flex:1;height:14px;background:#000;border:2px solid #fff;border-radius:8px;overflow:hidden}
.hpbar i{display:block;height:100%;width:100%;background:linear-gradient(#7dff9a,#1fbf5a);transition:width .4s}
.hpnum{text-align:right;font-size:15px;margin-top:2px}
#enemyInfo{font-size:16px;margin-top:6px;color:#fff}
.pips{display:inline-flex;gap:5px;vertical-align:middle;margin-left:6px}
.pips i{width:20px;height:14px;border:2px solid #fff;border-radius:3px;background:#ff4d6d}
.pips i.off{background:#222;border-color:#666}
.bhud-timer{position:absolute;left:50%;transform:translateX(-50%);top:8px;width:112px;text-align:center;padding:3px 6px}
.tlabel{font-size:12px;color:#bcd}
#timeNum{font-size:34px;line-height:1.05}
#timeNum.low{color:#ff5a5a;animation:blink .5s infinite}
#tbar{position:absolute;left:0;right:0;top:290px;height:9px;background:#000;border-top:2px solid #fff;border-bottom:2px solid #fff}
#tfill{display:block;height:100%;width:100%;background:linear-gradient(90deg,#46e2ff,#3b8bff)}
#tfill.low{background:linear-gradient(90deg,#ff9a3a,#ff3a3a)}
#qbox{position:absolute;left:12px;top:308px;width:936px;height:110px;padding:8px 16px}
#qtag{font-size:14px;color:var(--gold);margin-bottom:2px}
#qtext{font-size:21px;line-height:1.4}
#qtext.center{text-align:center;padding-top:20px;font-size:26px}
#qres{display:none}
#qverdict{font-size:22px;margin-bottom:2px}
#qverdict.ok{color:#6dffa0}#qverdict.ng{color:#ff7b80}
#qexp{font-size:16px;line-height:1.4;color:#e8ecff;padding-right:120px}
#nextBtn{position:absolute;right:14px;bottom:10px;display:none;padding:9px 16px;font-size:19px;background:var(--gold);color:#3a2200;border:3px solid #fff;border-radius:8px;animation:pulse .8s infinite alternate}
#choices{position:absolute;left:12px;top:424px;width:936px;height:108px;display:grid;grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr;gap:8px}
.ch{position:relative;text-align:left;font-size:18px;line-height:1.2;padding:3px 10px 3px 52px;background:linear-gradient(#1c2a78,#101a54);
  border:3px solid #fff;border-radius:9px;box-shadow:0 0 0 2px var(--ink);transition:.06s}
.ch::before{content:attr(data-n);position:absolute;left:8px;top:50%;transform:translateY(-50%);width:30px;height:30px;line-height:30px;text-align:center;
  background:var(--gold);color:#3a2200;border-radius:6px;font-size:19px}
.ch:hover:not(:disabled){border-color:var(--gold);background:linear-gradient(#2a3ba0,#16226e)}
.ch:disabled{cursor:default}
.ch.off{opacity:.35}
.ch.right{background:linear-gradient(#1f9a55,#0f6a36);border-color:#b6ffd1}
.ch.wrong{background:linear-gradient(#b8353a,#7a1a22);border-color:#ffb6b9}
#banner{position:absolute;left:0;right:0;top:92px;text-align:center;font-size:84px;pointer-events:none;opacity:0;
  -webkit-text-stroke:4px #000;paint-order:stroke fill;text-shadow:0 6px 0 rgba(0,0,0,.5)}
#banner.show{animation:banner 1s ease-out}
#banner.ok{color:#7dffa8}#banner.ng{color:#ff6a70}#banner.tm{color:#ffd54a}
@keyframes banner{0%{opacity:0;transform:scale(2.2)}15%{opacity:1;transform:scale(1)}75%{opacity:1}100%{opacity:0;transform:translateY(-20px)}}
@keyframes blink{50%{opacity:.35}}
@keyframes pulse{to{transform:translateY(-3px)}}

/* ===== 会話 ===== */
#dialog{position:absolute;left:0;right:0;bottom:0;height:540px;display:none;background:rgba(0,0,10,.35)}
#dialog.show{display:block}
.dbox{position:absolute;left:30px;right:30px;bottom:26px;height:170px;padding:14px 20px;display:flex;gap:18px}
#portrait{flex:none;width:120px;height:120px;background:radial-gradient(#2f3f9a,#0b1240);border:3px solid #fff;border-radius:10px}
.dtext{flex:1}
#dname{font-size:20px;color:var(--gold);margin-bottom:6px;min-height:26px}
#dline{font-size:23px;line-height:1.55}
#darrow{position:absolute;right:22px;bottom:12px;font-size:20px;animation:blink .8s infinite}

/* ===== ワーニング ===== */
#warn{position:absolute;inset:0;display:none;flex-direction:column;align-items:center;justify-content:center;background:rgba(120,0,20,.55);z-index:20}
#warn.show{display:flex;animation:blink .35s 4}
#warn div{font-size:110px;color:#fff;-webkit-text-stroke:5px #7a0010;paint-order:stroke fill;letter-spacing:.08em}
#warn small{font-size:30px;margin-top:6px;text-shadow:0 2px 0 #000}

/* ===== リザルト・モーダル ===== */
#result,#modal{position:absolute;inset:0;display:none;align-items:center;justify-content:center;background:rgba(0,0,12,.72);z-index:30}
#result.show,#modal.show{display:flex}
.rbox,.mbox{width:700px;max-height:500px;padding:22px 30px;text-align:center;overflow:auto}
.mbox{width:740px;text-align:left}
.rbox h2{font-size:44px;margin-bottom:10px;text-shadow:0 4px 0 rgba(0,0,0,.5)}
.rbox h2.win-t{color:var(--gold)}.rbox h2.lose-t{color:#ff6a70}
#rBody{font-size:21px;line-height:1.7;margin-bottom:14px}
#rBody b{color:var(--gold)}
.rbtns{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;margin-top:12px}
.rbtns button{padding:11px 22px;font-size:21px;background:linear-gradient(#1c2a80,#0d1550);border:3px solid #fff;border-radius:10px}
.rbtns button:hover{border-color:var(--gold);color:var(--gold)}
.mbox h3{font-size:28px;color:var(--gold);margin-bottom:10px;text-align:center}
.mbox p,.mbox li{font-size:18px;line-height:1.65}
.mbox ul{padding-left:22px}
.mbox input{font:inherit;font-size:24px;width:100%;padding:8px 12px;border-radius:8px;border:3px solid #fff;background:#0b1240;color:#fff;-webkit-user-select:text;user-select:text}
table.rk{width:100%;border-collapse:collapse;font-size:19px}
table.rk td,table.rk th{padding:4px 10px;border-bottom:1px dashed #5666b8;text-align:left}
table.rk tr.me{background:rgba(255,213,74,.22);color:var(--gold)}
.note{font-size:13px;color:#aab4e8;margin-top:8px}

#sndBtn{position:absolute;right:10px;bottom:8px;z-index:40;width:34px;height:34px;border-radius:50%;background:rgba(0,0,20,.6);border:2px solid #fff;font-size:16px}
#sndBtn.off{opacity:.4;text-decoration:line-through}
#battle.active ~ #sndBtn{top:248px;bottom:auto}
